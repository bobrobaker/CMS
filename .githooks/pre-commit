#!/bin/sh
# Tier-1 enforcement for CMS itself.
# Arm once per clone: git config core.hooksPath .githooks
ROOT="$(git rev-parse --show-toplevel)"
python3 "$ROOT/tools/cms_lint.py" || exit 1
# Guard the cms_lint ↔ lint_skeleton "edit both together" mirror (they duplicate by design to
# keep forks zero-dep; this asserts the copies still agree). See tools/test_lint_mirror.py.
python3 "$ROOT/tools/test_lint_mirror.py" >/dev/null || { python3 "$ROOT/tools/test_lint_mirror.py"; exit 1; }
# Behavioral guard for the self-improving lexical flag matcher. See tools/test_flag_corpus.py.
python3 "$ROOT/tools/test_flag_corpus.py" >/dev/null || { python3 "$ROOT/tools/test_flag_corpus.py"; exit 1; }
# Behavioral guard for the Stop-hook flag backstop (windowed scan, race recovery, code-span
# blanking, cross-layer dedup, write-counted cap). See tools/test_autoflag.py.
python3 "$ROOT/tools/test_autoflag.py" >/dev/null || { python3 "$ROOT/tools/test_autoflag.py"; exit 1; }
# Behavioral guard for the deploy-time settings merges (merge-not-clobber, global-archive split).
python3 "$ROOT/tools/test_deploy_settings.py" >/dev/null || { python3 "$ROOT/tools/test_deploy_settings.py"; exit 1; }
# Behavioral guard for the tier-2 craft reminder (rule merge, per-pointer markers, fail-open).
python3 "$ROOT/tools/test_craft_reminder.py" >/dev/null || { python3 "$ROOT/tools/test_craft_reminder.py"; exit 1; }
# Behavioral guard for the SessionEnd token-counting hook (summing, marker dedup, fail-open).
python3 "$ROOT/tools/test_session_tokens.py" >/dev/null || { python3 "$ROOT/tools/test_session_tokens.py"; exit 1; }
# Guard the eval-canary's pure logic: doctor-parse, the unwired-hook catch, twice-consecutive debounce.
python3 "$ROOT/tools/test_eval_canary.py" >/dev/null || { python3 "$ROOT/tools/test_eval_canary.py"; exit 1; }
# Correctness guard for the two doc-currency probes (two-headed decision doc; gated-vs-shipped),
# including the negatives (deliberate partial-supersession, genuinely-unbuilt feature).
python3 "$ROOT/tools/test_doc_currency.py" >/dev/null || { python3 "$ROOT/tools/test_doc_currency.py"; exit 1; }
# Age classification for the hook state-log health read — guards the forward-bracket
# (a backward one reports an ongoing outage as healthy). See tools/test_hook_error_scan.py.
python3 "$ROOT/tools/test_hook_error_scan.py" >/dev/null || { python3 "$ROOT/tools/test_hook_error_scan.py"; exit 1; }
# Keep the canonical managed-tools manifest fresh: bash is the sole hash producer, and the
# fork drift-check reads this committed file (never recomputes). See method/tooling.md.
# Fail loud, not silently: a refresh error must not ship a stale manifest (B02 trusts it).
# Errors here are deterministic env breakage (no sha256 tool, a missing managed file), not
# transient — surface them rather than swallow with `|| true`.
if "$ROOT/bootstrap.sh" --refresh-manifest >/dev/null; then
  git add "$ROOT/tools/.cms-manifest"
else
  echo "pre-commit: manifest refresh FAILED — commit aborted so a stale manifest can't ship." >&2
  echo "  (.cms-manifest may be left empty on disk; fix the cause, or 'git commit --no-verify' to override.)" >&2
  exit 1
fi
exit 0
