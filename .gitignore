# Monition store residue. The store normally lives at the cross-repo hub
# ($CMS_LANDING_ZONE/monition), not inside this repo; a standalone fork with no hub
# gets a local monition/ store here instead. Either way it is personal data (firings
# are session telemetry) and never published — these patterns keep a local store out.
monition/.dolt/
monition/store.db
monition/dump.sql

# Python bytecode and the semantic-layer venv (machine-local, ~2GB).
__pycache__/
*.pyc
.venv/

# Session/working residue — handoffs are local state, not public content.
handoffs/
